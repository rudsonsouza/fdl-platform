# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Back-end (Java / Maven)
[*.{java,kt,gradle}]
indent_size = 4

[pom.xml]
indent_size = 4

[*.sql]
indent_size = 4

# Wrapper Windows do Maven
[*.{cmd,bat}]
end_of_line = crlf

# Markdown: dois espaços no fim da linha = quebra de linha
[*.md]
trim_trailing_whitespace = false
