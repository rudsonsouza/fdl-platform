# Copie para .env (que é ignorado pelo Git) e ajuste. Nunca versione o .env.

# OBRIGATÓRIO. Segredo do JWT (HS256), com pelo menos 32 bytes.
# Gere com: openssl rand -base64 32
FDL_JWT_SECRET=

# Validade do token (duração ISO-8601). Padrão: 60 minutos.
FDL_JWT_TTL=PT60M

# Origens liberadas no CORS do back-end (separadas por vírgula). Com o nginx do compose o navegador
# fala com a própria origem, então isto só importa para quem usa o front-end em outra porta/host.
FDL_CORS_ORIGINS=http://localhost:5173

# Força do BCrypt (4 a 31). Padrão: 12.
FDL_BCRYPT_STRENGTH=12

# Swagger UI e /v3/api-docs. Use false para desligar.
FDL_SWAGGER_ENABLED=true
